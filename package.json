{
  "name": "stackprobe-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "schema": "node packages/core/scripts/write-schema.ts",
    "fingerprints": "node packages/core/scripts/build-fingerprints.ts",
    "record-fixture": "node packages/core/scripts/record-fixture.ts",
    "db:migrate": "node --env-file-if-exists=.env.local packages/store-postgres/scripts/migrate.ts",
    "record-ground-truth": "node packages/core/scripts/record-ground-truth.ts",
    "accuracy": "node packages/core/scripts/accuracy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
