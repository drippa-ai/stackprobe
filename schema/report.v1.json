{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "domain": {
      "type": "string"
    },
    "scannedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "fingerprintsVersion": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": ["unclassified", "marketing", "app", "api", "docs", "status", "auth", "other"]
          },
          "kindConfidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "detections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tech": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "version": {
                  "type": ["string", "null"]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["observed", "stated"]
                      },
                      "layer": {
                        "type": "string",
                        "enum": ["http", "dns", "tls", "browser"]
                      },
                      "ruleId": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": ["type", "layer", "ruleId", "detail", "weight"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["tech", "category", "version", "confidence", "evidence"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "url", "kind", "kindConfidence", "detections"],
        "additionalProperties": false
      }
    },
    "layersRun": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "string",
            "enum": ["http", "dns", "tls", "browser"]
          },
          "surfaceId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["ok", "failed", "timeout", "skipped"]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "TIMEOUT",
                  "DNS_NXDOMAIN",
                  "TLS_HANDSHAKE",
                  "HTTP_STATUS",
                  "CONNECT_FAILED",
                  "BLOCKED_PRIVATE_ADDRESS",
                  "BROWSER_UNAVAILABLE",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["layer", "surfaceId", "status", "durationMs"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "domain",
    "scannedAt",
    "fingerprintsVersion",
    "surfaces",
    "layersRun"
  ],
  "additionalProperties": false
}
