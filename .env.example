# Copy to .env.local (never committed) and fill in.

# Postgres connection string. For Supabase: Project → Connect → "Transaction pooler"
# (port 6543), with your database password filled in. URL-encode the password: characters
# like @ : / ? # % in it break the URL otherwise (for example @ becomes %40).
# The web app (apps/web) reads this file too, so one .env.local covers everything locally.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
