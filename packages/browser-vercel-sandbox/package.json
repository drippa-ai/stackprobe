{
  "name": "@drippa/stackprobe-browser-vercel-sandbox",
  "version": "0.0.0",
  "description": "Runs stackprobe's browser layer in a Vercel Sandbox, for the hosted app.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "build-source": "node scripts/build-source.ts",
    "create-snapshot": "node --env-file-if-exists=../../.env.vercel scripts/create-snapshot.ts"
  },
  "dependencies": {
    "@drippa/stackprobe-core": "workspace:*",
    "@vercel/sandbox": "^3.5.1"
  }
}
